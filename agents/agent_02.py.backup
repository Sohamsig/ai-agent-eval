            "retry_utils.py": """import time


def retry(func, attempts=3, delay=0):
    \"\"\"Retry a callable when it raises an exception.

    Returns the function result on success.
    Returns None if all attempts fail.
    \"\"\"
    if not callable(func):
        return None

    if not isinstance(attempts, int) or attempts <= 0:
        return None

    if not isinstance(delay, (int, float)) or delay < 0:
        return None

    for attempt in range(attempts):
        try:
            return func()
        except Exception:
            if attempt < attempts - 1 and delay > 0:
                time.sleep(delay)

    return None


def retry_with_default(func, default=None, attempts=3):
    \"\"\"Retry a callable and return a default value if all attempts fail.\"\"\"
    if not callable(func):
        return default

    if not isinstance(attempts, int) or attempts <= 0:
        return default

    for _ in range(attempts):
        try:
            return func()
        except Exception:
            continue

    return default
"""
        }

