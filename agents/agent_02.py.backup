            "feature_utils.py": """from config import get_config


def process_items(items, config=None):
    \"\"\"
    Process items according to the configured maximum item count.
    \"\"\"

    if not isinstance(items, (list, tuple)):
        return []

    if not items:
        return []

    max_items = get_config(config, "max_items", 10)

    if not isinstance(max_items, int) or isinstance(max_items, bool):
        max_items = 10

    if max_items <= 0:
        return []

    return list(items[:max_items])


def get_app_name(config=None):
    \"\"\"Return the configured application name.\"\"\"

    name = get_config(config, "app_name", "AgentBench")

    if not isinstance(name, str) or not name.strip():
        return "AgentBench"

    return name


def summarize_items(items, config=None):
    \"\"\"
    Return a summary containing the application name,
    number of processed items, and processed items.
    \"\"\"

    processed = process_items(items, config)

    return {
        "app_name": get_app_name(config),
        "count": len(processed),
        "items": processed,
    }
